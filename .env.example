# ─────────────────────────────────────────────────────────────────────────────
# Argos Alumni — variables de entorno
# Copiar a `.env.local`. NUNCA commitear valores reales.
# ─────────────────────────────────────────────────────────────────────────────

# ── Sesión de desarrollo (Fase 0) ────────────────────────────────────────────
# Provisional: el shell lee tenant y usuario de aquí mientras no exista auth.
# En Fase 1 estas tres desaparecen y las reemplaza Supabase Auth.
ARGOS_DEV_TENANT_SIGLAS="UDD"
ARGOS_DEV_TENANT_NAME="Universidad del Desarrollo"
ARGOS_DEV_USER_NAME="Nombre Apellido"

# ── Supabase (Fase 1) ────────────────────────────────────────────────────────
# Región del proyecto: PENDIENTE DE DEFINIR con el cliente antes de crearlo.
# Tiene implicancias de transferencia internacional bajo la Ley 21.719 (§12.6).
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# service_role: SOLO para el CLI de ingesta y las migraciones.
# Jamás en código que llegue al navegador (§11).
SUPABASE_SERVICE_ROLE_KEY=""

# Conexión directa de Postgres para Drizzle (migraciones y queries de servidor).
DATABASE_URL=""

# ── Ingesta desde Clay (Fase 2) ──────────────────────────────────────────────
# Secreto compartido para firmar el body con HMAC-SHA256 en POST /api/ingest/clay.
CLAY_WEBHOOK_SECRET=""

# ── API pública (Fase 6) ─────────────────────────────────────────────────────
# Pepper para el hash de las API keys almacenadas en `api_keys.key_hash`.
API_KEY_HASH_PEPPER=""
# Secreto para firmar los webhooks salientes (job_change.detected, alumnus.updated).
OUTBOUND_WEBHOOK_SECRET=""

# ── App ──────────────────────────────────────────────────────────────────────
# Dominio definitivo del portal: PENDIENTE. Afecta el envío de magic links.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
